$execute if data storage eden:settings mob_manager.villager_settings{villagecenter_healing:"daytime"} unless predicate mob_manager:time/night_time as @e[type=armor_stand,tag=mob_manager.village.name] at @s run execute as @e[type=#$(validmobs),distance=..$(village_heal_distance)] at @s run effect give @s regeneration 5 0 true
$execute if data storage eden:settings mob_manager.villager_settings{villagecenter_healing:"nighttime"} if predicate mob_manager:time/night_time as @e[type=armor_stand,tag=mob_manager.village.name] at @s run execute as @e[type=#$(validmobs),distance=..$(village_heal_distance)] at @s run effect give @s regeneration 5 0 true
$execute if data storage eden:settings mob_manager.villager_settings{villagecenter_healing:"always"} as @e[type=armor_stand,tag=mob_manager.village.name] at @s run execute as @e[type=#$(validmobs),distance=..$(village_heal_distance)] at @s run effect give @s regeneration 5 0 true
